{
  // Touch Share remote share: the matchmaker + the guest page, as one Cloudflare Worker.
  // The Worker's name in the Cloudflare dashboard must match "name" below.
  "name": "touch-share-remote",
  "main": "src/index.mjs",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "../web", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "SIGNALING", "class_name": "Signaling" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Signaling"] }]
}
